{
    "version": "2.1.0",
    "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "CryptoGuard SAST",
                    "informationUri": "https://github.com/Nazar4568/CryptoGuard",
                    "rules": []
                }
            },
            "results": [
                {
                    "ruleId": "CRYPTO001",
                    "level": "error",
                    "message": {
                        "text": "Found 'import random'. This module is not cryptographically secure."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "test_code.py"
                                },
                                "region": {
                                    "startLine": 2
                                }
                            }
                        }
                    ]
                },
                {
                    "ruleId": "CRYPTO002",
                    "level": "note",
                    "message": {
                        "text": "Found weak hash 'md5'. Ensure it's not used for security."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "test_code.py"
                                },
                                "region": {
                                    "startLine": 5
                                }
                            }
                        }
                    ]
                },
                {
                    "ruleId": "CRYPTO002",
                    "level": "error",
                    "message": {
                        "text": "CRITICAL: Weak hash 'md5' used on sensitive data ('password_string')."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "test_code.py"
                                },
                                "region": {
                                    "startLine": 8
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}